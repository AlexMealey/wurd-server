# Copy to .env, then: chmod 600 .env
# There is no server token: each user requests their own in Wurd's Vault tab.

# Required. A secret every vault key also depends on, kept here rather than in the data volume, so a copy
# of the volume alone opens nothing. Generate it once with: openssl rand -hex 32
# Keep a copy somewhere safe, apart from your volume backups: if it's lost or changed, no vault can be opened.
WURD_PEPPER=

# The Wurd frontend, served at /
# Recommended Default ../wurd
WURD_FRONTEND_DIR=../wurd
# Port on this machine (local mode)
WURD_PORT=8026

# Limits
WURD_MAX_FILE_MB=25
WURD_MAX_TOTAL_MB=1024
WURD_MAX_FILES=5000

# Only needed when Wurd is NOT opened from this server, e.g. from a file:// page (use: null)
# or another web server (use its origin, e.g. http://localhost:8000). Space-separated.
WURD_ALLOWED_ORIGINS=

# ---- LAN mode: docker compose --profile tls up -d ----
# The name or IP address other devices use to reach this machine, e.g. 192.168.1.10 or wurd.lan
WURD_HOST=localhost
# "internal" for a LAN. An email address gets a Let's Encrypt certificate instead (Internet use, discouraged).
WURD_TLS=internal
WURD_TLS_PORT=8443
# Docker network between Caddy and Wurd. Change both if the subnet clashes with another network.
WURD_SUBNET=172.29.84.0/24
WURD_PROXY_IP=172.29.84.10
